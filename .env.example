# Database password
DB_PASSWORD=changeme

# PostgreSQL connection string (no +psycopg modifier — injected
# at runtime)
DATABASE_URL=postgresql://meepletime:changeme@db:5432/meepletime

# ---------------------------------------------------------------
# Keycloak / OIDC settings (backend resource-server validation)
# ---------------------------------------------------------------

# Base URL of the Keycloak realm, e.g.:
#   http://keycloak:8080/realms/meepletime
OIDC_AUTHORITY=http://keycloak:8080/realms/meepletime

# The audience claim expected in access tokens.
# Set to the Keycloak client_id of the Vue frontend client.
OIDC_AUDIENCE=meepletime-frontend

# Must match the iss claim in tokens (usually same as
# OIDC_AUTHORITY).
OIDC_ISSUER=http://keycloak:8080/realms/meepletime

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost

# ---------------------------------------------------------------
# Frontend Vite environment variables (VITE_ prefix required)
# Copy these into frontend/.env.local for local development.
# ---------------------------------------------------------------

# Keycloak realm discovery document base URL
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/meepletime

# Public client_id registered in Keycloak (no secret needed)
VITE_OIDC_CLIENT_ID=meepletime-frontend

# Redirect URI registered in Keycloak for the auth callback
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# URI Keycloak redirects to after logout
VITE_OIDC_POST_LOGOUT_URI=http://localhost:5173/

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000
