# ---------------------------------------------------------------
# Production docker-compose variables
# Copy to .env and adjust for your environment.
#
# For local development outside Docker, see:
#   backend/.env.example   — backend service variables
#   frontend/.env.example  — frontend Vite variables
# ---------------------------------------------------------------

# Database password shared between the db and backend services.
DB_PASSWORD=changeme

# ---------------------------------------------------------------
# Backend resource-server (FastAPI)
# ---------------------------------------------------------------

DATABASE_URL=postgresql://meepletime:changeme@db:5432/meepletime

# Base URL of the Keycloak realm as reachable from the backend
# container (internal Docker network hostname).
OIDC_AUTHORITY=http://keycloak:8080/realms/meepletime

# client_id of the Keycloak bearer-only resource-server client.
OIDC_AUDIENCE=meepletime-backend

# Must match the iss claim in tokens (same as OIDC_AUTHORITY).
OIDC_ISSUER=http://keycloak:8080/realms/meepletime

# Allowed CORS origin for the Vue frontend.
FRONTEND_URL=http://localhost
