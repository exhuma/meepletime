# Production deployment configuration for MeepleTime.
# Copy to `.env` in this directory and fill in real values.
# See docs/operator/deployment.md for guidance.

# --- Published images (GHCR) ---------------------------------------
# Replace OWNER/REPO with your GitHub repository, and pin a version
# tag (e.g. v0.1.0) instead of `latest` for reproducible deploys.
BACKEND_IMAGE=ghcr.io/OWNER/REPO/backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/REPO/frontend:latest

# Host ports to publish. The backend must be reachable by browsers at
# MT_API_BASE_URL below, so expose it (or front it with a proxy/TLS).
BACKEND_PORT=8000
FRONTEND_PORT=80

# --- Backend (reads MEEPLETIME_* — see app/config.py) --------------
# External PostgreSQL provided by the OPS team.
MEEPLETIME_DATABASE_URL=postgresql://meepletime:CHANGEME@pg:5432/meepletime
# External Keycloak realm URL (issuer). Authority and issuer are the
# same realm URL in Option A.
MEEPLETIME_OIDC_AUTHORITY=https://keycloak.example.com/realms/meepletime
MEEPLETIME_OIDC_ISSUER=https://keycloak.example.com/realms/meepletime
MEEPLETIME_OIDC_AUDIENCE=meepletime-backend
# JSON array of allowed CORS origins (the frontend's public origin).
MEEPLETIME_CORS_ORIGINS=["https://meeple.example.com"]

# --- Frontend (browser-facing, injected into /config.js) -----------
MT_OIDC_AUTHORITY=https://keycloak.example.com/realms/meepletime
MT_OIDC_CLIENT_ID=meepletime-frontend
# Public base URL of the backend API (no trailing slash).
MT_API_BASE_URL=https://api.meeple.example.com
