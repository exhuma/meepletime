{
  "id": "meepletime",
  "realm": "meepletime",
  "enabled": true,
  "loginTheme": "meepletime",
  "accountTheme": "meepletime",
  "sslRequired": "none",
  "displayName": "MeepleTime",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 3600,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "client": {
      "meepletime-backend": [
        {
          "name": "user",
          "description": "Standard application user",
          "composite": false,
          "clientRole": true,
          "containerId": "meepletime-backend"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "meepletime-frontend",
      "name": "MeepleTime Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "meepletime-backend",
      "name": "MeepleTime Backend",
      "description": "OAuth 2.0 resource server — validates bearer tokens issued by the frontend client",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "devuser",
      "enabled": true,
      "emailVerified": true,
      "email": "devuser@example.com",
      "firstName": "Dev",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "devpass",
          "temporary": false
        }
      ],
      "clientRoles": {
        "meepletime-backend": ["user"]
      }
    },
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "clientRoles": {
        "meepletime-backend": ["user"]
      }
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "clientRoles": {
        "meepletime-backend": ["user"]
      }
    }
  ]
}
