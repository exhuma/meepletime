# frontend/.env.example
#
# Copy to frontend/.env.local for local development.
# Vite only exposes variables prefixed with VITE_ to the browser
# bundle. Never put secrets here.
#
# In the devcontainer this file is created automatically by
# .devcontainer/init.bash with the correct nip.io authority URL.
# ---------------------------------------------------------------

# Base URL of the Keycloak realm, reachable from the browser.
# Use the nip.io hostname in the devcontainer so it matches the
# iss claim that the backend validates.
VITE_OIDC_AUTHORITY=http://keycloak.127.0.0.1.nip.io:8080/realms/meepletime

# client_id of the public OIDC client used by this SPA.
# Must match a client registered in the Keycloak realm.
VITE_OIDC_CLIENT_ID=meepletime-frontend

# redirect_uri and post_logout_redirect_uri are derived from
# window.location.origin at runtime (see src/auth/oidc.ts) and
# must not be set here.

# Base URL of the FastAPI backend, reachable from the browser.
VITE_API_BASE_URL=http://localhost:8000

# Full URL of the GitHub repository. When set, a small "Source code"
# link appears in the app footer (build-time only; hidden when empty).
# VITE_GITHUB_REPO_URL=https://github.com/exhuma/meepletime

# App version shown in the footer. Normally injected at build time from
# the release git tag; falls back to package.json otherwise. Override
# only for local testing.
# VITE_APP_VERSION=2026.6.15-alpha.1

# Dev-only in-app login (no Keycloak). When 'true' AND running under
# the Vite dev server, LoginView shows a preset-user picker instead
# of redirecting to Keycloak. Pair it with the backend's
# MEEPLETIME_DEV_AUTH_ENABLED.
#
# Only honoured under `vite` (the dev server); any production build
# (`vite build`) statically excludes the dev-login code regardless,
# so this can never ship in a built artefact.
# VITE_DEV_AUTH=true
