{
  // NOTE: The dev-container is OPTIONAL and human-oriented. Coding
  // agents should run on the host instead — see
  // docs/developer/host-run.md and the "Running on the host" section
  // in AGENTS.md.
  // MeepleTime — FastAPI + Vue 3 + PostgreSQL + Keycloak
  "name": "meepletime",
  // Use a docker-compose stack so PostgreSQL and Keycloak start
  // automatically alongside the devcontainer.
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  // Install backend and frontend dependencies after the container
  // is created.
  "postCreateCommand": "bash .devcontainer/init.bash",
  // Ensure ~/.local/bin (where Task is installed) is on PATH
  // for every terminal and task launched inside the container.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/root/.local/bin"
  },
  // Forward backend API, Vite dev server, PostgreSQL, and
  // Keycloak admin UI.
  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        // Vue / TypeScript
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        // Docker
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
        "typescript.tsdk": "frontend/node_modules/typescript/lib",
        "editor.formatOnSave": true,
        // Python — ruff as both linter and formatter.
        // Config source: backend/pyproject.toml [tool.ruff]
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "ruff.configuration": "${workspaceFolder}/backend/pyproject.toml",
        // JS / TS / Vue / JSON — prettier as formatter.
        // Config source: frontend/.prettierrc.json
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[vue]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "prettier.configPath": "frontend/.prettierrc.json"
      }
    }
  }
}
