# backend/.env.example
#
# Copy to backend/.env for local development.
# These variables are backend-only and are never exposed to the
# browser. pydantic-settings loads .env relative to the working
# directory, so run uvicorn and alembic from backend/.
#
# In the devcontainer this file is created automatically by
# .devcontainer/init.bash with the correct nip.io URLs.
# ---------------------------------------------------------------

DATABASE_URL=postgresql://meepletime:changeme@db:5432/meepletime

# ---------------------------------------------------------------
# OIDC resource-server validation
# ---------------------------------------------------------------

# Base URL of the Keycloak realm, reachable from the backend
# process. In the devcontainer this is the nip.io hostname so
# that token iss claims match identically on host and container.
OIDC_AUTHORITY=http://keycloak.127.0.0.1.nip.io:8080/realms/meepletime

# client_id of the Keycloak bearer-only resource-server client
# whose name appears in the aud claim of access tokens.
OIDC_AUDIENCE=meepletime-backend

# Must equal the iss claim in access tokens (same as
# OIDC_AUTHORITY).
OIDC_ISSUER=http://keycloak.127.0.0.1.nip.io:8080/realms/meepletime

# Allowed CORS origin for the Vue frontend.
FRONTEND_URL=http://localhost:5173
