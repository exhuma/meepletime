# backend/.env.example
#
# Copy to backend/.env for local development.
# All variables are prefixed with MEEPLETIME_ to avoid
# collisions with other applications sharing the environment.
# pydantic-settings loads .env relative to the working
# directory, so run uvicorn and alembic from backend/.
#
# In the devcontainer this file is created automatically by
# .devcontainer/init.bash with the correct nip.io URLs.
# ---------------------------------------------------------------

MEEPLETIME_DATABASE_URL=postgresql://meepletime:changeme@db:5432/meepletime

# ---------------------------------------------------------------
# OIDC resource-server validation
# ---------------------------------------------------------------

# Base URL of the Keycloak realm, reachable from the backend
# process. In the devcontainer this is the nip.io hostname so
# that token iss claims match identically on host and container.
MEEPLETIME_OIDC_AUTHORITY=http://keycloak.127.0.0.1.nip.io:8080/realms/meepletime

# client_id of the Keycloak bearer-only resource-server client
# whose name appears in the aud claim of access tokens.
MEEPLETIME_OIDC_AUDIENCE=meepletime-backend

# Must equal the iss claim in access tokens (same as
# MEEPLETIME_OIDC_AUTHORITY).
MEEPLETIME_OIDC_ISSUER=http://keycloak.127.0.0.1.nip.io:8080/realms/meepletime

# ---------------------------------------------------------------
# Dev-token support (headless agents and coding environments)
# ---------------------------------------------------------------

# When set, the backend accepts self-minted HS256 JWTs (generated
# with `task dev:token`) instead of validating via Keycloak JWKS.
# This removes the need for a running Keycloak instance during
# agent-driven development.
#
# **NEVER set this in production.**
#
# Pick any sufficiently random string; 32+ characters recommended.
# MEEPLETIME_DEV_SHARED_SECRET=change-me-dev-only-secret

# When true, mounts the in-app dev-login endpoints (/auth/dev/*)
# so the SPA can authenticate without a running Keycloak. Requires
# MEEPLETIME_DEV_SHARED_SECRET (used to sign the minted tokens); the
# backend refuses to start if this is enabled without that secret.
#
# **NEVER set this in production.** The router is not even mounted
# unless this flag is true, so production stays a clean 404.
# MEEPLETIME_DEV_AUTH_ENABLED=true

# ---------------------------------------------------------------
# Outbound links (notification + email-confirmation messages)
# ---------------------------------------------------------------

# Public base URL of the frontend SPA. The backend embeds this in
# the links it sends by email (notification deep links and the
# address-confirmation link), so it must be the URL users reach the
# app at. Defaults to the Vite dev server; override in production.
MEEPLETIME_APP_BASE_URL=http://localhost:5173
